(export (version "E")
  (design (source "buck.kicad_sch") (tool "Eeschema 8.0.9"))
  (components
    (comp (ref "U1") (value "TPS62000")
      (description "Buck converter")
      (libsource (lib "Regulator_Switching") (part "TPS62000") (description "Buck converter"))
      (sheetpath (names "/") (tstamps "/")) (tstamps "1"))
    (comp (ref "L1") (value "4u7")
      (libsource (lib "Device") (part "L") (description "Inductor"))
      (sheetpath (names "/") (tstamps "/")) (tstamps "2"))
    (comp (ref "U2") (value "MCU")
      (libsource (lib "Fixture") (part "MCU") (description "Microcontroller"))
      (sheetpath (names "/") (tstamps "/")) (tstamps "3")))
  (libparts
    (libpart (lib "Regulator_Switching") (part "TPS62000") (description "Buck converter")
      (pins
        (pin (num "1") (name "VIN") (type "power_in"))
        (pin (num "2") (name "SW") (type "power_out"))
        (pin (num "3") (name "GND") (type "power_in"))
        (pin (num "4") (name "FB") (type "input"))))
    (libpart (lib "Device") (part "L") (description "Inductor")
      (pins
        (pin (num "1") (name "1") (type "passive"))
        (pin (num "2") (name "2") (type "passive"))))
    (libpart (lib "Fixture") (part "MCU") (description "Microcontroller")
      (pins
        (pin (num "1") (name "VDD") (type "power_in"))
        (pin (num "2") (name "VSS") (type "power_in"))
        (pin (num "3") (name "SCL") (type "bidirectional"))
        (pin (num "4") (name "SDA") (type "bidirectional"))
        (pin (num "5") (name "EN") (type "input"))
        (pin (num "6") (name "AUX") (type "power_in")))))
  (nets
    (net (code "1") (name "+5V") (node (ref "U1") (pin "1") (pintype "power_in")))
    (net (code "2") (name "/SW") (node (ref "U1") (pin "2") (pintype "power_out")) (node (ref "L1") (pin "1") (pintype "passive")))
    (net (code "3") (name "+1V25") (node (ref "L1") (pin "2") (pintype "passive")) (node (ref "U1") (pin "4") (pintype "input")) (node (ref "U2") (pin "1") (pintype "power_in")))
    (net (code "4") (name "GND") (node (ref "U1") (pin "3") (pintype "power_in")) (node (ref "U2") (pin "2") (pintype "power_in")))
    (net (code "5") (name "/I2C_SCL_+1V2") (node (ref "U2") (pin "3") (pintype "bidirectional")))
    (net (code "6") (name "/I2C_SDA_+1V2") (node (ref "U2") (pin "4") (pintype "bidirectional")))
    (net (code "7") (name "/EN") (node (ref "U2") (pin "5") (pintype "input")))
    (net (code "8") (name "/AUX") (node (ref "U2") (pin "6") (pintype "power_in")))))
