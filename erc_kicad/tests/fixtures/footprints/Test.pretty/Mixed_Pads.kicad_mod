(footprint "Mixed_Pads"
	(version 20240108)
	(generator "pcbnew")
	(generator_version "8.0")
	(layer "F.Cu")
	(descr "Test footprint with one pad of each kind: oval drill with offset, trapezoid, chamfered, custom, NPTH; a keepout and a copper polygon")
	(property "Reference" "REF**" (at 0 -4 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "Mixed_Pads" (at 0 4 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(attr through_hole)
	(clearance 0.2)
	(zone_connect 2)
	(fp_arc (start -3 -2.5) (mid -2.2 -3.2) (end -1.2 -3) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start -1.2 -3) (end 3.5 -3) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 3.5 -3) (end 3.5 3) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 3.5 3) (end -3 3) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start -3 3) (end -3 -2.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_circle (center 2.5 2) (end 2.9 2) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(fp_poly (pts (xy 0.5 1.6) (xy 2 1.6) (xy 2 2.4) (xy 0.9 2.4)) (stroke (width 0) (type solid)) (fill solid) (layer "F.Cu"))
	(fp_line (start -2.5 2.6) (end -1.5 2.6) (stroke (width 0.1) (type solid)) (layer "Edge.Cuts"))
	(pad "1" thru_hole oval (at -2 -1.2 30) (size 1.6 2.4) (drill oval 0.8 1.4 (offset 0 0.2))
		(layers "*.Cu" "*.Mask") (remove_unused_layers no) (thermal_bridge_angle 45))
	(pad "2" smd trapezoid (at 0 -1.5) (size 1 1.4) (rect_delta 0 0.3) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "3" smd roundrect (at 2 -1.5 90) (size 1.2 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0)
		(chamfer_ratio 0.25) (chamfer top_left bottom_right) (solder_mask_margin 0.02))
	(pad "4" smd custom (at 0 1) (size 0.6 0.6) (layers "F.Cu" "F.Mask")
		(options (clearance convexhull) (anchor circle))
		(primitives
			(gr_poly (pts (xy -0.3 0) (xy 1 -0.5) (xy 1.2 0.4)) (width 0) (fill yes))
			(gr_circle (center 0.8 0.2) (end 1.1 0.2) (width 0.1) (fill no))))
	(pad "" np_thru_hole circle (at -2 1.8) (size 1 1) (drill 1) (layers "*.Cu" "*.Mask"))
	(zone (net 0) (net_name "") (layers "F.Cu") (hatch edge 0.5)
		(connect_pads (clearance 0))
		(min_thickness 0.25)
		(keepout (tracks not_allowed) (vias not_allowed) (pads allowed) (copperpour not_allowed) (footprints allowed))
		(fill (thermal_gap 0.5) (thermal_bridge_width 0.5))
		(polygon (pts (xy 1 0.2) (xy 3 0.2) (xy 3 1.2) (xy 1.4 1.2))))
)
